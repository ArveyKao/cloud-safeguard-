  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "3.0.5"
  }
}

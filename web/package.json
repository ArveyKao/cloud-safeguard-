{
  "name": "cloud-safeguard-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cloud Safeguard console: approve your agents' access, manage cloud accounts and people.",
  "scripts": {
    "dev": "vite --port 18803 --strictPort",
    "build": "tsc --noEmit && vite build",
